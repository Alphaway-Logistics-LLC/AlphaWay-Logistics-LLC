# Environment variables - NEVER commit these!
.env
.env.local
.env.*.local

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db

# Build output
dist/
build/

# Temporary files
*.tmp
*.temp
*.log

# Archives (consider removing these or moving elsewhere)
*.zip
*.tar.gz

# Git directory (shouldn't be here anyway)
.git/

# Uploaded files
uploads/
uploads/*
!uploads/.gitkeep
